PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=levelnlearn
JWT_SECRET=your-jwt-secret-minimum-32-characters-long

# Frontend URL for email links (verification and password reset)
FRONTEND_URL=http://localhost:3000

# Email configuration (SMTP)
# For Gmail: use smtp.gmail.com, port 587, secure=false, and an app password
# For development/testing: leave blank to use Ethereal test account
MAIL_FROM=no-reply@levelnlearn.local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

# Pusher configuration (real-time features)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Client origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
